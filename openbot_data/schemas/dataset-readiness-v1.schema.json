{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbot.ai/schemas/openbot.dataset_readiness.v1.json",
  "title": "OpenBot Dataset Readiness v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "fingerprint_version",
    "profile",
    "status",
    "coverage",
    "blocking_findings",
    "warnings",
    "advisory_signals",
    "triage",
    "remediation",
    "snapshot_fingerprint",
    "audit_rule_pack_version",
    "tool",
    "readiness_fingerprint"
  ],
  "properties": {
    "schema_version": {"const": "openbot.dataset_readiness.v1"},
    "fingerprint_version": {
      "const": "openbot.dataset_readiness.fingerprint.v1"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "source_version",
        "source_reference",
        "contract_source",
        "metadata_source"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "source_version": {"type": "string", "minLength": 1},
        "source_reference": {"type": "string", "minLength": 1},
        "contract_source": {"enum": ["built_in", "policy_config"]},
        "metadata_source": {
          "enum": ["snapshot_format_metadata", "publication_metadata"]
        }
      }
    },
    "status": {"enum": ["READY", "BLOCKED", "PARTIAL"]},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_integrity",
        "required_integrity",
        "capabilities",
        "missing_capabilities",
        "selection",
        "totals"
      ],
      "properties": {
        "requested_integrity": {"enum": ["metadata", "sample", "full"]},
        "required_integrity": {"enum": ["metadata", "sample", "full"]},
        "capabilities": {
          "type": "array",
          "items": {"type": "object"}
        },
        "missing_capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["capability", "status", "reason_code"],
            "properties": {
              "capability": {"type": "string", "minLength": 1},
              "status": {"type": "string", "minLength": 1},
              "reason_code": {"type": ["string", "null"]}
            }
          }
        },
        "selection": {"type": "object"},
        "totals": {"type": "object"}
      }
    },
    "blocking_findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "warnings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "advisory_signals": {
      "type": "array",
      "items": {"$ref": "#/$defs/advisory"}
    },
    "triage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "group",
          "blocking_findings",
          "warnings",
          "advisories"
        ],
        "properties": {
          "group": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "location"],
            "properties": {
              "kind": {
                "enum": ["episode", "feature", "camera", "shard", "dataset"]
              },
              "location": {"type": "object"}
            }
          },
          "blocking_findings": {
            "type": "array",
            "items": {"type": "object"}
          },
          "warnings": {
            "type": "array",
            "items": {"type": "object"}
          },
          "advisories": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "snapshot_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "audit_rule_pack_version": {"type": ["string", "null"]},
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "openbot-data"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "readiness_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "layer",
        "message",
        "location",
        "evidence",
        "impact",
        "fixability",
        "remediation_ref"
      ],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"enum": ["error", "warning", "info"]},
        "layer": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "location": {"type": "object"},
        "evidence": {"type": "object"},
        "impact": {"type": "string", "minLength": 1},
        "fixability": {"type": "string", "minLength": 1},
        "remediation_ref": {"type": "string", "minLength": 1}
      }
    },
    "advisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "layer",
        "message",
        "raw_value",
        "unit",
        "threshold",
        "threshold_source",
        "applicability",
        "coverage",
        "location",
        "evidence"
      ],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "severity": {"const": "advisory"},
        "layer": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1},
        "raw_value": {},
        "unit": {"type": "string", "minLength": 1},
        "threshold": {},
        "threshold_source": {"type": "string", "minLength": 1},
        "applicability": {"type": "string", "minLength": 1},
        "coverage": {"type": "object"},
        "location": {"type": "object"},
        "evidence": {"type": "object"}
      }
    }
  }
}
