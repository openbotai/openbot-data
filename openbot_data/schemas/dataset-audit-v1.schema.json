{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbot.ai/schemas/openbot.dataset_audit.v1.json",
  "title": "OpenBot Dataset Audit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_format",
    "summary",
    "rule_pack_version",
    "coverage",
    "skipped_checks",
    "findings"
  ],
  "properties": {
    "schema_version": {"const": "openbot.dataset_audit.v1"},
    "input_format": {"type": "string"},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["videos", "error", "warning", "info"],
      "properties": {
        "videos": {"type": "integer", "minimum": 0},
        "error": {"type": "integer", "minimum": 0},
        "warning": {"type": "integer", "minimum": 0},
        "info": {"type": "integer", "minimum": 0}
      }
    },
    "rule_pack_version": {"type": "string", "minLength": 1},
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capabilities"],
      "properties": {
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capabilityCoverage"}
        },
        "source": {"type": "object"}
      }
    },
    "skipped_checks": {
      "type": "array",
      "items": {"$ref": "#/$defs/skippedCheck"}
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "locator", "requested_revision", "resolved_revision"],
      "properties": {
        "kind": {"const": "hf_hub"},
        "locator": {"type": "string", "minLength": 1},
        "requested_revision": {"type": "string", "minLength": 1},
        "resolved_revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "severity",
          "layer",
          "rule_id",
          "message",
          "location",
          "evidence",
          "impact",
          "fixability",
          "remediation_ref"
        ],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["error", "warning", "info"]},
          "layer": {
            "enum": [
              "metadata",
              "schema",
              "data",
              "media",
              "alignment",
              "provenance"
            ]
          },
          "rule_id": {"type": "string", "minLength": 1},
          "message": {"type": "string"},
          "path": {"type": "string"},
          "location": {"type": "object"},
          "evidence": {"type": "object"},
          "impact": {"type": "string", "minLength": 1},
          "fixability": {
            "enum": ["automatic", "delegated", "manual", "not_repairable"]
          },
          "remediation_ref": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "capabilityCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "status",
        "integrity",
        "checked",
        "total",
        "selected",
        "omitted"
      ],
      "properties": {
        "capability": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["complete", "partial", "skipped", "unavailable"]
        },
        "integrity": {"enum": ["metadata", "sample", "full"]},
        "checked": {"type": "integer", "minimum": 0},
        "total": {"type": ["integer", "null"], "minimum": 0},
        "selected": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "omitted": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "skippedCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "layer",
        "missing_capabilities",
        "reason_code",
        "reason",
        "location"
      ],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "layer": {
          "enum": [
            "metadata",
            "schema",
            "data",
            "media",
            "alignment",
            "provenance"
          ]
        },
        "missing_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "reason_code": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "path": {"type": "string"},
        "location": {"type": "object"}
      }
    }
  }
}
