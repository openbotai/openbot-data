{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openbot.ai/schemas/openbot.dataset_manifest.v1.json",
  "title": "OpenBot Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool_version",
    "input_format",
    "dataset_fingerprint",
    "path_bases",
    "episodes",
    "video_keys",
    "discovery_findings",
    "total_videos",
    "valid_videos",
    "total_previews",
    "preview_failures",
    "videos"
  ],
  "properties": {
    "schema_version": {"const": "openbot.dataset_manifest.v1"},
    "tool_version": {"type": "string"},
    "input_format": {"enum": ["video", "lerobot"]},
    "codebase_version": {"type": ["string", "null"]},
    "dataset_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path_bases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "inspection"],
      "properties": {
        "dataset": {
          "type": "object",
          "required": ["resolution"],
          "properties": {
            "resolution": {"const": "caller_supplied_dataset_root"}
          }
        },
        "inspection": {
          "type": "object",
          "required": ["resolution"],
          "properties": {
            "resolution": {"const": "manifest_parent_parent"}
          }
        }
      }
    },
    "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}},
    "video_keys": {"type": "array", "items": {"type": "string"}},
    "discovery_findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "total_videos": {"type": "integer", "minimum": 0},
    "valid_videos": {"type": "integer", "minimum": 0},
    "total_previews": {"type": "integer", "minimum": 0},
    "preview_failures": {"type": "integer", "minimum": 0},
    "videos": {"type": "array", "items": {"$ref": "#/$defs/video"}}
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["code", "severity", "message", "evidence"],
      "properties": {
        "code": {"type": "string"},
        "severity": {"enum": ["error", "warning", "info"]},
        "message": {"type": "string"},
        "path": {"type": "string"},
        "evidence": {"type": "object"}
      }
    },
    "episode": {
      "type": "object",
      "required": ["episode_index", "length", "tasks", "video_files"],
      "properties": {
        "episode_index": {"type": "integer", "minimum": 0},
        "length": {"type": ["integer", "null"], "minimum": 0},
        "tasks": {"type": "array", "items": {"type": "string"}},
        "video_files": {"type": "array", "items": {"type": "string"}},
        "video_segments": {"type": "array", "items": {"type": "object"}}
      }
    },
    "preview": {
      "type": "object",
      "required": [
        "frame_id",
        "video_path",
        "video_path_base",
        "frame_number",
        "timestamp",
        "path",
        "path_base"
      ],
      "properties": {
        "frame_id": {"type": "string"},
        "video_path": {"type": "string"},
        "video_path_base": {"const": "dataset"},
        "frame_number": {"type": "integer", "minimum": 0},
        "timestamp": {"type": "number", "minimum": 0},
        "path": {"type": "string"},
        "path_base": {"const": "inspection"}
      }
    },
    "video": {
      "type": "object",
      "required": [
        "path_base",
        "path",
        "filename",
        "stream",
        "width",
        "height",
        "fps",
        "frame_count",
        "duration",
        "size_bytes",
        "metadata_valid",
        "decode_valid",
        "integrity_level",
        "is_valid",
        "previews",
        "preview_status",
        "preview_failures"
      ],
      "properties": {
        "path_base": {"const": "dataset"},
        "path": {"type": "string"},
        "filename": {"type": "string"},
        "stream": {"type": "string"},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "fps": {"type": "number", "minimum": 0},
        "frame_count": {"type": "integer", "minimum": 0},
        "duration": {"type": "number", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 0},
        "size_mb": {"type": "number", "minimum": 0},
        "metadata_valid": {"type": "boolean"},
        "decode_valid": {"type": ["boolean", "null"]},
        "decoded_frame_count": {"type": ["integer", "null"], "minimum": 0},
        "integrity_level": {"enum": ["metadata", "sample", "full"]},
        "is_valid": {"type": "boolean"},
        "error": {"type": ["string", "null"]},
        "checksum_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "previews": {"type": "array", "items": {"$ref": "#/$defs/preview"}},
        "preview_status": {"type": "string"},
        "preview_error": {"type": ["string", "null"]},
        "preview_failures": {"type": "array"}
      }
    }
  }
}
