{
  "id": "lerobot-smolvla",
  "version": "1",
  "source_version": "lerobot==0.6.0",
  "source_reference": "https://github.com/huggingface/lerobot/tree/v0.6.0/src/lerobot/policies/smolvla",
  "required_integrity": "full",
  "input_formats": ["lerobot"],
  "adapters": ["lerobot_v30"],
  "dataset_versions": ["v3.0", "3.0"],
  "required_capabilities": [
    "format.contract",
    "metadata.info",
    "metadata.episodes",
    "metadata.tasks",
    "metadata.totals",
    "metadata.episode_indexes",
    "data.inventory",
    "data.parquet_footer",
    "data.parquet_schema",
    "data.parquet_rows",
    "data.indexes",
    "alignment.data_relations",
    "alignment.episode_ranges",
    "alignment.timestamps",
    "alignment.task_foreign_keys",
    "alignment.video_relations",
    "media.inventory",
    "media.declared_contract",
    "stats.stored",
    "stats.recomputed"
  ],
  "required_features": [
    {
      "key": "action",
      "role": "output",
      "dtype": "float32",
      "shape_min_rank": 1,
      "shape_last_dimension_max": 32
    }
  ],
  "any_feature_groups": [
    {
      "id": "smolvla-camera",
      "patterns": ["observation.images.*"],
      "minimum": 1
    }
  ],
  "metadata_requirements": [],
  "advisory_metadata": [],
  "thresholds": {
    "near_zero_variance": 1e-12,
    "variance_threshold_source": "lerobot-smolvla-v1 advisory"
  },
  "policy_defaults": {
    "normalization_mapping": {
      "VISUAL": "IDENTITY",
      "STATE": "MEAN_STD",
      "ACTION": "MEAN_STD"
    },
    "observation_delta_indices": [0],
    "action_delta_indices": {"start": 0, "stop": 50},
    "max_state_dim": 32,
    "max_action_dim": 32
  }
}
